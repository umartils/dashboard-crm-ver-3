# ===== Database (dipakai docker-compose.db.yml) =====
# Tips: openssl rand -hex 24  -> password aman tanpa karakter khusus
# MYSQL_* hanya berlaku saat volume masih kosong (inisialisasi pertama)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=dashboard_db
MYSQL_USER=dashboard_user
MYSQL_PASSWORD=

# ===== Dipakai bersama frontend dan backend =====
INTERNAL_API_KEY=

# ===== Backend (FastAPI) =====
APP_ENV=production
# DASHBOARD_DATABASE_URL dirakit otomatis di docker-compose.yml dari MYSQL_*
SOURCE_DATABASE_URL=mysql+pymysql://user:password@host:3306/nama_db_sumber
RFM_CRON_HOUR=2
RFM_CRON_MINUTE=0
CORS_ORIGINS=https://dashboard-crm.intermn.site

# ===== Frontend (Next.js) =====
# AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_GOOGLE_DOMAINS=
ALLOWED_GOOGLE_EMAILS=
# Nama service backend di network Docker, bukan localhost
BACKEND_URL=http://backend:8000
AUTH_TRUST_HOST=true
AUTH_URL=https://dashboard-crm.intermn.site
NEXT_PUBLIC_APP_NAME=
